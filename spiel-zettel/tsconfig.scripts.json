{
  "compilerOptions": {
    // Common
    "target": "es6",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Libraries
    "lib": ["ES2022"]
  },
  "include": ["scripts/**/*", "examples/**/*"]
}
