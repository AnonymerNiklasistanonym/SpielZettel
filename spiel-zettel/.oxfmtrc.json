{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": {
    // Blank line between groups
    "newlinesBetween": true,
    // Grouping order
    "groups": [
      // 1. Other imports (external, internal, etc.)
      ["value-builtin", "value-external", "value-internal"],
      // 2. Side-effect imports (this is where reset.css, globals.css, and fontsource css live)
      "side_effect",
      // 3. Your CSS Modules (this is where page.module.css will go)
      "css-modules",
      // 4. Other relative imports if any
      ["value-parent", "value-sibling", "value-index"]
    ],
    "customGroups": [
      {
        "groupName": "css-modules",
        // Match files ending in .module.css
        "elementNamePattern": ["**/*.module.css"],
        // Force it to be treated as a value import, not a side effect
        "modifiers": ["value"]
      }
    ],
    // Classify your @/ alias as internal
    "internalPattern": ["^@/"]
  },
  "ignorePatterns": []
}
