{
  "name": "spiel-zettel",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npx serve -p 8000 build",
    "start:https": "npx http-server -S -C cert.pem -p 8000 build",
    "create": "npm-run-all create:*",
    "create:schema": "tsx --tsconfig tsconfig.scripts.json scripts/createJsonSchema.ts",
    "create:examples": "tsx --tsconfig tsconfig.scripts.json scripts/createExamples.ts",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-http-backend": "^4.0.6",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.0",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "image-type": "^6.1.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
