{
  "name": "spiel-zettel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "format": "vp fmt --check",
    "start": "npx serve -p 8000 build",
    "start:https": "npx http-server -S -C cert.pem -p 8000 build",
    "create": "npm-run-all create:*",
    "create:schema": "vpx --tsconfig tsconfig.scripts.json scripts/createJsonSchema.ts",
    "create:examples": "vpx --tsconfig tsconfig.scripts.json scripts/createExamples.ts",
    "fix": "npm-run-all *:fix",
    "check": "vp check",
    "format:fix": "vp fmt --write",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@formio/vm": "^2.3.1",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-http-backend": "^4.0.6",
    "idb": "^8.0.4",
    "image-type": "^6.1.0",
    "jszip": "^3.10.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.1",
    "react-toastify": "^11.2.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "npm-run-all": "^4.1.5",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "isolated-vm": "^7.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
